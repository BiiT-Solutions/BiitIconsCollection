{
  "name": "@biit-solutions/biit-icons-collection",
  "version": "1.2.0",
  "author": "BiiT Sourcing Solutions",
  "type": "module",
  "sideEffects": false,
  "license": "AGPLv3",
  "scripts": {
    "clean": "npx rimraf dist",
    "dev": "npm run clean && npm run transform-icons && vite",
    "build": "npm run clean && npm run build:lib && vite build && npm run copy-library-assets",
    "build:lib": "npm run transform-icons",
    "preview": "npm run build && vite preview",
    "transform-icons": "svg-to-ts-files",
    "copy-library-assets": "node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/icons',{recursive:true}); fs.copyFileSync('package.json','dist/icons/package.json'); fs.copyFileSync('README.md','dist/icons/README.md');\"",
    "auto-publish": "npm run build && npm publish --access=public dist/icons/"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "svg-to-ts": "^12.0.0",
    "vite": "^8.0.14"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BiiT-Solutions/BiitIconsCollection.git"
  }
}
